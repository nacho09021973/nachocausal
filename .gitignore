# exploration sandbox: the dev/ exploration SCRIPTS are committed as scoped
# exceptions so they sync across machines via the GitHub clone (see README /
# CLAUDE.md). Only the generated raw data below stays out of git.

# generated dev ensemble output (raw sprinkling data) is never committed
dev_ensemble_raw/
dev/**/__pycache__/
# generated dev artifacts (logs, dumped O multisets) — regenerable, don't sync
dev/*.log
dev/o_samples.json

# generated benchmark artifacts (raw ensembles, dry-run output) -- not committed.
# The committed verdict record lives in docs/, separate from raw data (cmte SWE).
results/

# local literature library (papers, books, derived notes) -- not committed
biblioteca/

# outreach drafts for item 5 (external readers): contain recipient names and
# tactical send decisions. Repo rule (external_reader_candidates_n1_n5.md intro,
# phase2_novelty_and_item5.md §3.3): no email addresses and no choice of persons
# in the tracked tree. Local only, never pushed.
email/
